filters:
  and:
    - 'file.inFolder("knowledge_base/04-Questions")'
    - "note.note_type == \"question\""
    - "note.syllabus_status == \"in-scope\""
    - "note.verification_status == \"verified\""
formulas:
  title: "file.asLink(file.name.split(\" - \").slice(1).join(\" - \"))"
properties:
  note.id:
    displayName: "ID"
  formula.title:
    displayName: "Title / 题目"
  note.methods:
    displayName: "Methods / 方法"
  note.topics:
    displayName: "Topics / 主题"
  note.question_types:
    displayName: "Question type / 题型"
  note.difficulty:
    displayName: "Difficulty / 难度"
  note.year:
    displayName: "Year / 年份"
  note.subtopics:
    displayName: "Subtopics / 子主题"
  note.concepts:
    displayName: "Concepts / 概念"
  note.source_paper:
    displayName: "Paper / 试卷"
views:
  -
    type: "table"
    name: "Method Summary"
    groupBy:
      property: "note.methods"
      direction: "ASC"
    sort:
      -
        property: "note.difficulty"
        direction: "ASC"
      -
        property: "note.year"
        direction: "DESC"
      -
        property: "note.id"
        direction: "ASC"
    summaries:
      note.id: "Filled"
    order:
      - "note.id"
      - "formula.title"
      - "note.methods"
      - "note.topics"
      - "note.question_types"
      - "note.difficulty"
      - "note.year"
  -
    type: "table"
    name: "METH-ALGORITHM-TRACE-INVARIANT - Questions"
    filters: "note.methods.contains(link(\"knowledge_base/02-Methods/Algorithm Trace and Invariant Method - 算法跟踪与不变量方法.md\"))"
    sort:
      -
        property: "note.year"
        direction: "DESC"
      -
        property: "note.id"
        direction: "ASC"
    summaries:
      note.id: "Filled"
    order:
      - "note.id"
      - "formula.title"
      - "note.subtopics"
      - "note.concepts"
      - "note.methods"
      - "note.question_types"
      - "note.difficulty"
      - "note.year"
      - "note.source_paper"
  -
    type: "table"
    name: "METH-ASYM-BOUND - Questions"
    filters: "note.methods.contains(link(\"knowledge_base/02-Methods/Asymptotic Bound Method - 渐近界方法.md\"))"
    sort:
      -
        property: "note.year"
        direction: "DESC"
      -
        property: "note.id"
        direction: "ASC"
    summaries:
      note.id: "Filled"
    order:
      - "note.id"
      - "formula.title"
      - "note.subtopics"
      - "note.concepts"
      - "note.methods"
      - "note.question_types"
      - "note.difficulty"
      - "note.year"
      - "note.source_paper"
  -
    type: "table"
    name: "METH-CASE - Questions"
