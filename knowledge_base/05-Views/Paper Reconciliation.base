filters:
  and:
    - 'file.inFolder("knowledge_base/03-Papers")'
    - "note.note_type == \"paper\""
formulas:
  term_order: "if(note.term == \"spring\", 0, if(note.term == \"fall\", 1, 2))"
  exam_order: "if(note.exam_type == \"midterm\", 0, 1)"
properties:
  file.name:
    displayName: "Note / 笔记"
  note.year:
    displayName: "Year / 年份"
  note.term:
    displayName: "Term / 学期"
  note.exam_type:
    displayName: "Exam / 考试"
  note.identified_count:
    displayName: "Identified / 已识别"
  note.admitted_count:
    displayName: "Admitted / 已纳入"
  note.excluded_count:
    displayName: "Excluded / 已排除"
  note.unresolved_count:
    displayName: "Unresolved / 未解决"
  note.text_layer_status:
    displayName: "Text layer / 文字层"
  note.duplicate_of:
    displayName: "Duplicate of / 重复源"
  note.source_aliases:
    displayName: "Duplicate aliases / 同源文件"
  note.verification_status:
    displayName: "Verification / 核验"
  formula.term_order:
    displayName: "Term order"
  formula.exam_order:
    displayName: "Exam order"
views:
  -
    type: "table"
    name: "Paper Reconciliation"
    sort:
      -
        property: "note.year"
        direction: "DESC"
      -
        property: "formula.term_order"
        direction: "ASC"
      -
        property: "formula.exam_order"
        direction: "ASC"
      -
        property: "file.name"
        direction: "ASC"
    summaries:
      note.identified_count: "Sum"
      note.admitted_count: "Sum"
      note.excluded_count: "Sum"
      note.unresolved_count: "Sum"
    order:
      - "file.name"
      - "note.year"
      - "note.term"
      - "note.exam_type"
      - "note.identified_count"
      - "note.admitted_count"
      - "note.excluded_count"
      - "note.unresolved_count"
      - "note.text_layer_status"
      - "note.duplicate_of"
      - "note.source_aliases"
      - "note.verification_status"
  -
    type: "table"
    name: "P-2013-FINAL - Reconciliation"
    filters: "note.id == \"P-2013-FINAL\""
    order:
      - "file.name"
      - "note.year"
      - "note.term"
      - "note.exam_type"
      - "note.identified_count"
      - "note.admitted_count"
      - "note.excluded_count"
      - "note.unresolved_count"
      - "note.text_layer_status"
      - "note.duplicate_of"
      - "note.source_aliases"
      - "note.verification_status"
  -
    type: "table"
    name: "P-2013-MID - Reconciliation"
