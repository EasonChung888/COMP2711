filters:
  and:
    - 'file.inFolder("knowledge_base/04-Questions")'
    - "note.note_type == \"question\""
    - "note.syllabus_status == \"in-scope\""
    - "note.verification_status == \"verified\""
formulas:
  title: "file.asLink(file.name.split(\" - \").slice(1).join(\" - \"))"
properties:
  note.id:
    displayName: "ID"
  formula.title:
    displayName: "Title / 题目"
  note.question_types:
    displayName: "Question type / 题型"
  note.difficulty:
    displayName: "Difficulty / 难度"
  note.topics:
    displayName: "Topics / 主题"
  note.methods:
    displayName: "Methods / 方法"
  note.year:
    displayName: "Year / 年份"
views:
  -
    type: "table"
    name: "Question Type then Difficulty"
    groupBy:
      property: "note.question_types"
      direction: "ASC"
    sort:
      -
        property: "note.difficulty"
        direction: "ASC"
      -
        property: "note.year"
        direction: "DESC"
      -
        property: "note.id"
        direction: "ASC"
    summaries:
      note.id: "Filled"
    order:
      - "note.id"
      - "formula.title"
      - "note.question_types"
      - "note.difficulty"
      - "note.topics"
      - "note.methods"
      - "note.year"
  -
    type: "table"
    name: "Difficulty then Question Type"
    groupBy:
      property: "note.difficulty"
      direction: "ASC"
    sort:
      -
        property: "note.question_types"
        direction: "ASC"
