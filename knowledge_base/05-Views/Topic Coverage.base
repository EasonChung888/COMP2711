filters:
  and:
    - 'file.inFolder("knowledge_base/04-Questions")'
    - "note.note_type == \"question\""
    - "note.syllabus_status == \"in-scope\""
    - "note.verification_status == \"verified\""
formulas:
  title: "file.asLink(file.name.split(\" - \").slice(1).join(\" - \"))"
properties:
  note.id:
    displayName: "ID"
  formula.title:
    displayName: "Title / 题目"
  note.topics:
    displayName: "Topics / 主题"
  note.subtopics:
    displayName: "Subtopics / 子主题"
  note.concepts:
    displayName: "Concepts / 概念"
  note.difficulty:
    displayName: "Difficulty / 难度"
  note.year:
    displayName: "Year / 年份"
  note.methods:
    displayName: "Methods / 方法"
  note.question_types:
    displayName: "Question type / 题型"
  note.source_paper:
    displayName: "Paper / 试卷"
views:
  -
    type: "table"
    name: "Topic and Subtopic Summary"
    groupBy:
      property: "note.topics"
      direction: "ASC"
    sort:
      -
        property: "note.subtopics"
        direction: "ASC"
      -
        property: "note.year"
        direction: "DESC"
      -
        property: "note.id"
        direction: "ASC"
    summaries:
      note.id: "Filled"
    order:
      - "note.id"
      - "formula.title"
      - "note.topics"
      - "note.subtopics"
      - "note.concepts"
      - "note.difficulty"
      - "note.year"
  -
    type: "table"
    name: "CON-ALGORITHM-CORRECTNESS - Questions"
    filters: "note.concepts.contains(link(\"knowledge_base/01-Topics/Concepts/Algorithm Correctness - 算法正确性.md\"))"
    sort:
      -
        property: "note.year"
        direction: "DESC"
      -
        property: "note.id"
        direction: "ASC"
    summaries:
      note.id: "Filled"
    order:
      - "note.id"
      - "formula.title"
      - "note.subtopics"
      - "note.concepts"
      - "note.methods"
      - "note.question_types"
      - "note.difficulty"
      - "note.year"
      - "note.source_paper"
  -
    type: "table"
    name: "CON-ASYM - Questions"
    filters: "note.concepts.contains(link(\"knowledge_base/01-Topics/Concepts/Asymptotic Complexity - 渐近复杂度.md\"))"
